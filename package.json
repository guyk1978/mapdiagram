{
  "name": "mapdiagram",
  "private": true,
  "type": "module",
  "scripts": {
    "build:flowchart": "vite build --config vite.flowchart.config.ts",

    "build:arch": "vite build --config vite.architecture.config.ts",

    "build:compilers": "npm run build:flowchart && npm run build:arch",

    "test:flowchart": "vitest run tests/flowchart",

    "test:stabilization": "vitest run tests/stabilization",

    "test:runtime": "vitest run tests/runtime",

    "build:tool-runtime": "vite build --config vite.tool-runtime.config.ts",

    "test:e2e": "playwright test",

    "test:e2e:install": "playwright install chromium",

    "test": "npm run test:flowchart && npm run test:stabilization && npm run test:runtime"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/dagre": "^0.7.52",
    "happy-dom": "^20.9.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "dagre": "^0.8.5"
  }
}